---
import LaborJourney from '../components/LaborJourney.astro';
import DhtAktuell from '../components/DhtAktuell.astro';
import Default from '../layouts/Default.astro';
import Nav from '../components/Nav.astro';
import Einstieg from '../components/Einstieg.astro';
import LlmConcept from '../components/LlmConcept.astro';
import Hero from '../components/Hero.astro';
import Apps from '../components/Apps.astro';
import Aufbau from '../components/Aufbau.astro';
import PitchWir from '../components/PitchWir.astro';
import PitchVorteil from '../components/PitchVorteil.astro';
import PitchProblem from '../components/PitchProblem.astro';
import PitchModell from '../components/PitchModell.astro';
import PitchJahr from '../components/PitchJahr.astro';
import PitchZukunft from '../components/PitchZukunft.astro';
import ContactFooter from '../components/ContactFooter.astro';
---
<Default><Nav /><main id="inhalt" class="sx-home"><Einstieg /><LlmConcept /><Hero /><DhtAktuell /><Apps /><Aufbau /><LaborJourney /><PitchWir /><PitchVorteil /><PitchProblem /><PitchModell /><PitchJahr /><PitchZukunft /></main><ContactFooter /><script is:inline>
(function () {
  /* Rubrik und Titel je Kartenzeile auf gleiche Hoehe bringen, damit Titel und Text bündig stehen. */
  var SEL = [':scope > .sx-sub, :scope > .sx-step', ':scope > h3'];
  function run() {
    document.querySelectorAll('.sx-cg').forEach(function (g) {
      var cards = [].slice.call(g.children);
      SEL.forEach(function (sel) {
        cards.forEach(function (c) { var l = c.querySelector(sel); if (l) l.style.minHeight = ''; });
        var rows = {};
        cards.forEach(function (c) { var l = c.querySelector(sel); if (l) (rows[c.offsetTop] = rows[c.offsetTop] || []).push(l); });
        Object.keys(rows).forEach(function (k) {
          var m = 0; rows[k].forEach(function (l) { m = Math.max(m, l.getBoundingClientRect().height); });
          if (rows[k].length > 1) rows[k].forEach(function (l) { l.style.minHeight = m + 'px'; });
        });
      });
    });
  }
  var t;
  function later() { clearTimeout(t); t = setTimeout(run, 60); }
  if (document.readyState !== 'loading') run(); else document.addEventListener('DOMContentLoaded', run);
  window.addEventListener('load', run);
  window.addEventListener('resize', later);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(run);
})();
</script></Default>
