const slides = [
 ['DHT','Anatomie gemeinsam erkunden','Investorenpitch · Interaktiver Körperatlas für Browser, iPhone und Mac'],
 ['Das Problem im Gespräch','Anatomische Begriffe brauchen einen sichtbaren Bezug zum Körper.','Eine gemeinsam bedienbare Körperansicht kann die Erklärung unterstützen. Der Nutzen für Verständnis und Abläufe ist noch zu belegen.'],
 ['Die Lösung DHT','Körper erkunden und Zusammenhänge sichtbar machen.','Körper drehen, Schichten wechseln, Strukturen suchen und auswählen. Quellen und Grenzen begleiten die Darstellung.'],
 ['Live-Demo','Browser zuerst','Körper erkunden, Schichten wechseln und Strukturen auswählen. Die Demo verwendet Beispieldaten.'],
 ['Browser: Auslieferung belegt','GitHub: 382/382 Dateien über HTTP und SHA-256 bestätigt.','Praxis-Webseite: 383/383 Dateien nach Paketkorrektur laut Zusammenstellung. Der Primärbericht der Korrektur wurde für das Faktenblatt nicht separat ausgewertet.'],
 ['Native Plattformen','iOS: 63/63 Simulatorfälle bestanden; 0/8 Hardwarefälle ausgeführt.','Mac: 13/16 Gruppen, 8/10 Funktionen und getrennt 30/30 native Testmethoden. Geräteabnahmen, Signatur und reale Schlüsselprüfung sind offen.'],
 ['Datenschutz: Ansatz und Testbeleg','Persönliche Daten sollen lokal bleiben; der Browser nutzt Beispieldaten.','Am Mac wurden verschlüsselte Speicherbereiche mit Testschlüsseln und 30 gerichtete Querzugriffspaare geprüft. Produktive Schlüssel und reale Freigaben sind noch offen.'],
 ['Atlas und Quellen','Die Darstellung beruht auf benannten Anatomiequellen.','Quellen und Lizenzhinweise sind in der Demo zugänglich. Historische Fragen zu Ableitungen bleiben offen.'],
 ['Entwicklung im Agentenverbund','Umfang und Abnahme werden ärztlich vorgegeben.','Getrennte Arbeitsstränge bearbeiten Browser, native Integration, Atlas und Gegenprüfung. Nur belegte Prüfungen zählen; reale Freigaben bleiben erforderlich.'],
 ['Nutzenhypothese und Prüffragen','Die Körperansicht soll Gespräche und eigenständiges Erkunden begleiten.','Zu prüfen sind Verständnis, tatsächliche Bedienung, Zielgruppe und Geschäftsmodell. Marktgröße und Zahlungsbereitschaft sind nicht belegt.'],
 ['Nächste Schritte','Mac: Signatur, Notarisierung und reale Eigentümer- und Schlüsselprüfung.','iPhone: betreute Face-ID- und HealthKit-Abnahme. Vorführung prüfen; anschließend Pilotplanung mit messbaren Fragen vorschlagen.'],
 ['DHT im Gespräch','Eine erkundbare Körperwelt als Ausgangspunkt.','Demo ansehen und Kriterien für eine Pilotbewertung vereinbaren. Technischer Stand mit offenen Abnahmen.']
];
