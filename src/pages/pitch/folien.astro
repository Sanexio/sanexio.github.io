<!doctype html><html lang="de"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>DHT · Präsentation | Sanexio</title><meta name="description" content="DHT-Investorenpitch als Präsentation"/><style>
:root{font-family:system-ui,sans-serif;color:#18333e;background:#f6f8f8}*{box-sizing:border-box}body{margin:0}.deck{min-height:100svh;display:flex;flex-direction:column}.bar,.controls{display:flex;align-items:center;justify-content:space-between;gap:.7rem;padding:.7rem clamp(1rem,4vw,3rem);background:#123c48;color:white}.bar a{color:white}#slides{flex:1;display:flex}.slide{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:center;max-width:1100px;width:100%;margin:auto;padding:clamp(1.2rem,5vw,5rem);overflow-wrap:anywhere}.slide[hidden]{display:none}h1{font-size:clamp(2rem,6vw,4.8rem);line-height:1.08;margin:0 0 1rem;color:#123c48}p{font-size:clamp(1.1rem,2.4vw,1.9rem);line-height:1.45;max-width:48ch}.lead{font-weight:700;color:#ad2738}.controls button,.demo{font:inherit;border:1px solid #fff;border-radius:.5rem;padding:.7rem 1rem;min-height:44px;background:transparent;color:white;cursor:pointer}.controls button:disabled{opacity:.45}.demo{background:#123c48;text-decoration:none;display:inline-block;align-self:start}.hint{font-size:.8rem}.counter{white-space:nowrap}@media(max-width:600px){.hint{display:none}.slide{justify-content:flex-start;padding-block:2rem}.bar,.controls{flex-wrap:wrap}}
</style></head><body><div class="deck"><header class="bar"><a href="/pitch/">← Zum Pitch</a><span>Sanexio · DHT</span><button id="fullscreen" type="button">Vollbild</button></header><main id="slides" aria-live="polite">{slides.map(([title,lead,body],i)=><section class="slide" hidden={i!==0} aria-label={`Folie ${i+1} von ${slides.length}`}><h1>{title}</h1><p class="lead">{lead}</p><p>{body}</p>{i===3&&<a class="demo" href="https://sanexio.github.io/dht-abnahme-2/">Live-Demo öffnen</a>}<p class="hint">Dokumentierter technischer Stand: 24.11.2026 · Offene Abnahmen beachten</p></section>)}</main><footer class="controls"><button type="button" id="prev">← Zurück</button><span class="counter" id="counter"></span><span class="hint">Pfeiltasten oder Wischen</span><button type="button" id="next">Weiter →</button></footer></div><script is:inline>
(()=>{const slides=[...document.querySelectorAll('.slide')],prev=document.querySelector('#prev'),next=document.querySelector('#next'),counter=document.querySelector('#counter');let current=Math.max(0,Math.min(slides.length-1,(Number(location.hash.slice(1))||1)-1));function show(n){current=Math.max(0,Math.min(slides.length-1,n));slides.forEach((s,i)=>s.hidden=i!==current);counter.textContent=`${current+1} / ${slides.length}`;prev.disabled=current===0;next.disabled=current===slides.length-1;history.replaceState(null,'',`#${current+1}`)}prev.onclick=()=>show(current-1);next.onclick=()=>show(current+1);document.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();show(current+(e.key==='ArrowRight'?1:-1))}});let start=null;const area=document.querySelector('#slides');area.addEventListener('touchstart',e=>{start=e.changedTouches[0].clientX},{passive:true});area.addEventListener('touchend',e=>{if(start!==null){const d=e.changedTouches[0].clientX-start;if(Math.abs(d)>50)show(current+(d<0?1:-1));start=null}},{passive:true});document.querySelector('#fullscreen').onclick=()=>{if(!document.fullscreenElement)document.documentElement.requestFullscreen?.();else document.exitFullscreen?.()};show(current)})();
</script></body></html>
