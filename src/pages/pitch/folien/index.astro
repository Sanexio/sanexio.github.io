---
import Default from '../../../layouts/Default.astro';
import Nav from '../../../components/Nav.astro';
const slides = [
 {tag:'Sanexio · Digital Health Twin', title:'Gesundheit verstehen. Gemeinsam gestalten.', text:'Der Digital Health Twin soll Menschen, ihre Gesundheitsdaten und die ärztliche Begleitung verbinden.', visual:['Mensch','Digital Health Twin','Medizin']},
 {tag:'01 · Patient-Empowerment', title:'Meine Gesundheit. Meine Daten.', text:'Patientinnen und Patienten sollen selbst über ihre Gesundheit und ihre Daten verfügen – und entscheiden, was sie mit wem teilen.', visual:['Verstehen','Entscheiden','Handeln']},
 {tag:'02 · Digitale Patientenakte', title:'Die eigene Gesundheitsgeschichte im Twin.', text:'Das Ziel: eine persönliche digitale Patientenakte, die Informationen und Entwicklungen im eigenen Twin zusammenführt. Die Browser-Demo zeigt ausschließlich Beispieldaten.', visual:['Befunde','Verläufe','Eigener Twin']},
 {tag:'03 · Selbst aktiv werden', title:'Ein Programm für die eigene Gesundheit.', text:'Ein Trainingsprogramm soll Menschen dabei unterstützen, ihre Gesundheit selbst zu optimieren und Veränderungen nachzuvollziehen.', visual:['Ausgangspunkt','Programm','Entwicklung']},
 {tag:'04 · Verbindung', title:'Ein gemeinsamer Bezugspunkt für Patient und Arzt.', text:'Der DHT soll die Schnittstelle zwischen dem Alltag der Patienten und der ärztlichen Begleitung bilden.', visual:['Patient','Digital Health Twin','Arzt']},
 {tag:'05 · Ärztliche Programme', title:'Ärztliche Programme – Ergebnisse im eigenen Twin.', text:'Ärzte sollen ihren Patienten über eigene Programme die Möglichkeit geben, Auswirkungen und Ergebnisse auf den eigenen Twin zu übertragen.', visual:['Messen →','Programm →','Verlauf im eigenen Twin →','Nachmessen']},
 {tag:'06 · Distributionsnetzwerk', title:'Ärztliche Programme erreichen Menschen.', text:'Der DHT kann so als Distributionsnetzwerk für ärztliche Programme dienen: Ärzte stellen ihre Programme bereit, Patienten nutzen sie im eigenen Twin.', visual:['Ärztliche Programme','DHT','Patienten']},
 {tag:'07 · Cortex für Ärzte', title:'Mehr Werkzeuge für den Praxisalltag.', text:'Bausteine der Cortex-Plattform für die Praxis – teils im Praxiseinsatz, teils in Entwicklung: Patientenportal – für Zugang und Kommunikation; Praxis-Webseite – für Information; workforce-time – Arbeitszeiterfassung.', visual:['Patientenportal','Praxis-Webseite','workforce-time']},
 {tag:'08 · Das Gesamtbild', title:'Nexus im Zentrum. Cortex als App-Store.', text:'Nexus ist die zentrale Stelle. Cortex ist der App-Store für Apps für Patienten und Praxen. Der Digital Health Twin ist die wichtigste App.', visual:['Nexus · zentrale Stelle','Cortex · App-Store','DHT · wichtigste App','Weitere Apps']},
 {tag:'09 · Stand und Demo', title:'Den Körperatlas heute erleben.', text:'Die Browser-Demo zeigt Körperansicht, Schichten und Strukturauswahl. Patientenakte und Programme sind Zielbild; die Geräteabnahmen stehen noch aus.', visual:['Körperansicht','Schichten','Strukturauswahl'], demo:true},
 {tag:'10 · Kontakt', title:'Lassen Sie uns Gesundheit gemeinsam gestalten.', text:'Sprechen Sie mit Sanexio über den Digital Health Twin und die nächsten Schritte.', visual:['Sanexio','Cortex','Digital Health Twin'], contact:true}
];
---
<Default title="Präsentation · Digital Health Twin | Sanexio" description="Der Digital Health Twin und das Zusammenspiel von Patient, Arzt, Cortex und Nexus." canonical="https://sanexio.github.io/pitch/folien/">
<Nav />
<main id="inhalt" class="deck sx-container">
 <div class="deck-top"><a href="/investoren/">← Investoren</a><div><button type="button" id="theme">Dunkel</button><button type="button" id="fullscreen">Vollbild</button></div></div>
 <div class="deck-frame" id="deck" aria-label="Präsentation Digital Health Twin">
 {slides.map((s,i)=><section class="slide" data-slide={i} hidden={i !== 0} aria-label={`Folie ${i+1} von ${slides.length}`}><div class="slide-copy"><p class="sx-eyebrow">{s.tag}</p><h1>{s.title}</h1><p class="sx-lead">{s.text}</p>{s.demo && <a class="sx-btn sx-btn-primary" href="https://sanexio.github.io/dht-abnahme-2/">Live-Demo öffnen ↗</a>}{s.contact && <a class="sx-btn sx-btn-primary" href="mailto:s.stracke@sanexio.de">Kontakt aufnehmen ↗</a>}{i>0 && i<9 && <p class="note">Zielbild · in Entwicklung</p>}</div><div class:list={['diagram', {'diagram-center': i===8, 'diagram-loop': i===5}]} aria-label="Schaubild"><svg class="diagram-line" viewBox="0 0 400 100" aria-hidden="true" preserveAspectRatio="none"><path d="M 10 50 H 390 M 375 40 L 390 50 L 375 60" fill="none" stroke="currentColor" stroke-width="2" /></svg>{s.visual.map((v,j)=><div class:list={['node', {'node-accent': (i===8 && j===0) || (i!==8 && j===1)}]}><span>{v}</span></div>)}</div></section>)}
 </div>
 <div class="deck-controls"><button type="button" id="prev" aria-label="Vorherige Folie">← Zurück</button><span id="counter" aria-live="polite">1 / {slides.length}</span><button type="button" id="next" aria-label="Nächste Folie">Weiter →</button></div><p class="hint">Pfeiltasten oder Wischen zum Weiterblättern</p>
</main>
</Default>
<style>
:global(.sx-nav){position:relative}.deck{padding-top:1.25rem;padding-bottom:2rem}.deck-top,.deck-controls{display:flex;justify-content:space-between;align-items:center;gap:1rem}.deck-top a{color:var(--sx-c-ink-subtle);text-decoration:none}.deck button{font:inherit;cursor:pointer;border:1px solid var(--sx-c-line);border-radius:var(--sx-radius-pill);padding:.65rem 1rem;background:var(--sx-c-surface);color:var(--sx-c-ink)}.deck button:disabled{opacity:.4;cursor:default}.deck-frame{margin:1.5rem 0;border:1px solid var(--sx-c-line);border-radius:var(--sx-radius-card);background:var(--sx-c-surface);box-shadow:var(--sx-shadow-card);overflow:hidden}.slide{min-height:clamp(440px,53vh,630px);padding:clamp(2rem,6vw,6rem);display:grid;grid-template-columns:1.1fr 1fr;align-items:center;gap:clamp(2rem,5vw,5rem)}.slide[hidden]{display:none}.slide h1{font-size:clamp(2.5rem,4.5vw,4.5rem);line-height:1.04;letter-spacing:-.045em;margin:.6rem 0 1.5rem}.slide .sx-lead{max-width:32rem}.note,.hint{font-size:.85rem;color:var(--sx-c-ink-muted);margin-top:2rem}.diagram{position:relative;display:flex;align-items:center;justify-content:center;gap:.6rem;flex-wrap:wrap}.diagram-line{position:absolute;width:90%;height:100px;color:var(--sx-c-accent);z-index:0}.node{position:relative;z-index:1;display:grid;place-items:center;text-align:center;min-height:100px;min-width:110px;flex:1;padding:1rem;border-radius:var(--sx-radius-card);border:1px solid var(--sx-c-line);background:var(--sx-c-bg-soft);font-weight:600}.node-accent{background:var(--sx-c-accent);color:white;border-color:var(--sx-c-accent)}.diagram-center .diagram-line{display:none}.diagram-center .node:first-child{flex-basis:100%;min-height:150px;font-size:1.5rem}.deck-controls #counter{color:var(--sx-c-ink-muted);font-variant-numeric:tabular-nums}.hint{text-align:center;margin:1rem 0}.deck:fullscreen{background:var(--sx-c-bg);max-width:none;overflow:auto;padding:2rem 5vw}.deck:fullscreen .deck-frame{min-height:75vh}.deck:fullscreen .slide{min-height:75vh}:global(html.deck-dark){--sx-c-bg:#1d1d1f;--sx-c-surface:#29292c;--sx-c-bg-soft:#37373b;--sx-c-ink:#f5f5f7;--sx-c-ink-subtle:#ddd;--sx-c-ink-muted:#aaa;--sx-c-line:#555;color-scheme:dark}:global(html.deck-dark body){background:var(--sx-c-bg);color:var(--sx-c-ink)}@media(max-width:700px){.slide{grid-template-columns:1fr;min-height:600px;gap:2rem}.slide h1{font-size:2.6rem}.diagram{gap:.4rem}.node{min-width:90px;min-height:75px;font-size:.78rem;overflow-wrap:anywhere}.deck-top{font-size:.85rem}.deck button{padding:.6rem .8rem}}
</style>
<script>
const slides=[...document.querySelectorAll<HTMLElement>('[data-slide]')]; const prev=document.querySelector<HTMLButtonElement>('#prev')!; const next=document.querySelector<HTMLButtonElement>('#next')!; const counter=document.querySelector('#counter')!; let index=Math.max(0,Math.min(slides.length-1,Number(location.hash.slice(1))-1||0));
function show(n:number){index=Math.max(0,Math.min(slides.length-1,n));slides.forEach((s,i)=>s.hidden=i!==index);prev.disabled=index===0;next.disabled=index===slides.length-1;counter.textContent=`${index+1} / ${slides.length}`;history.replaceState(null,'',`#${index+1}`)}
function navigate(n:number){show(n);if(innerWidth<=700)document.querySelector('.deck-frame')?.scrollIntoView({block:'start'})}prev.addEventListener('click',()=>navigate(index-1));next.addEventListener('click',()=>navigate(index+1));document.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='PageDown'){e.preventDefault();show(index+1)}if(e.key==='ArrowLeft'||e.key==='PageUp'){e.preventDefault();show(index-1)}});let x=0;const frame=document.querySelector('#deck')!;frame.addEventListener('touchstart',e=>{x=(e as TouchEvent).changedTouches[0].clientX},{passive:true});frame.addEventListener('touchend',e=>{const d=(e as TouchEvent).changedTouches[0].clientX-x;if(Math.abs(d)>50)show(index+(d<0?1:-1))},{passive:true});document.querySelector('#fullscreen')!.addEventListener('click',()=>{if(document.fullscreenElement)document.exitFullscreen();else document.querySelector('.deck')?.requestFullscreen()});document.querySelector('#theme')!.addEventListener('click',e=>{const dark=document.documentElement.classList.toggle('deck-dark');(e.currentTarget as HTMLElement).textContent=dark?'Hell':'Dunkel'});show(index);
</script>
