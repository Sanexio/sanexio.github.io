---
import Default from '../layouts/Default.astro';
import Nav from '../components/Nav.astro';
import ContactFooter from '../components/ContactFooter.astro';

const title = 'Digital Health Twin – Vorschau (MVP) | Sanexio';
const description =
  'Frühe Testfassung des Digital Health Twin: Schmerzorte an einer Körperfigur markieren — ohne Anmeldung, ohne Datenübertragung.';
---

<Default {title} {description} canonical={new URL('/dht/', Astro.site).href} noindex>
  <Nav />
  <main id="inhalt">
    <section class="sx-section" aria-labelledby="dht-mvp-title">
      <div class="sx-container sx-prose">
        <p class="sx-eyebrow">Testseite</p>
        <h2 id="dht-mvp-title">Digital Health Twin (DHT) – Vorschau (MVP)</h2>
        <p>Hier können Sie eine frühe Testfassung unseres Digital Health Twin ausprobieren. Erkunden Sie den Körper Schicht für Schicht – Haut, Muskeln, Skelett, Organe – oder suchen Sie gezielt nach einem Organ. Sie können auch zeigen, wo es weh tut. Ohne Anmeldung, ohne Datenübertragung: Ihre Angaben bleiben auf Ihrem Gerät.</p>
        <p>Der DHT ist ein MVP: Er ist noch nicht vollständig, und nicht alles funktioniert schon so, wie wir es uns vorstellen. Er stellt keine Diagnose und ersetzt keine ärztliche Behandlung.</p>
        <p>Ihre Meinung hilft uns: Was fehlt, was ist unklar, was würden Sie anders machen? Schreiben Sie uns Ihre Verbesserungsvorschläge über unsere Kontaktseite – bitte ohne Gesundheitsangaben.</p>
        <div class="sx-actions">
          <a class="sx-btn sx-btn-primary" href="/#kontakt">Verbesserungsvorschlag senden</a>
        </div>
      </div>
    </section>

    <section class="sx-section sx-soft" aria-label="Digital Health Twin Schmerzauswahl">
      <div class="sx-container sx-dht-frame-wrap">
        <iframe
          id="dht-auswahl"
          title="Körperauswahl"
          src="/dht-test/index.html"
          class="sx-dht-frame"
        ></iframe>
      </div>
    </section>
  </main>
  <ContactFooter />
</Default>

<script is:inline>
  const frame = document.getElementById('dht-auswahl');
  if (frame) {
    const childOrigin = new URL(frame.src, location.href).origin;
    let retry;
    window.addEventListener('message', (event) => {
      if (event.source !== frame.contentWindow || event.origin !== childOrigin) return;
      if (!Number.isInteger(event.data) || event.data < 1 || event.data > 100000) return;
      clearInterval(retry);
      frame.style.height = event.data + 'px';
    });
    function requestHeight() {
      frame.contentWindow?.postMessage('dht-height-request', childOrigin);
    }
    retry = setInterval(requestHeight, 200);
    setTimeout(() => clearInterval(retry), 10000);
    frame.addEventListener('load', requestHeight);
    requestHeight();
  }
</script>

<style>
  .sx-dht-frame-wrap {
    width: 100%;
    max-width: none;
  }
  .sx-dht-frame {
    display: block;
    width: 100%;
    min-height: 520px;
    border: 1px solid var(--sx-c-line);
    border-radius: var(--sx-radius-card);
    background: var(--sx-c-surface);
  }
</style>