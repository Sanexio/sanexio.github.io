---
import { getCollection, render } from 'astro:content';
import OrganGallery from '../../components/OrganGallery.astro';
import anatomy from '../../data/anatomy.json';
import BlogArticle from '../../layouts/BlogArticle.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const pageTitle = `${post.data.title} — Sanexio DHT-Blog`;
---

<BlogArticle
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  stagingNote={post.data.stagingNote}
  pageTitle={pageTitle}
  ogImage={post.data.organs.length ? `/anatomy/og/${post.data.organs[0]}.jpg` : undefined}
  ogImageAlt={post.data.organs.length ? `${anatomy[post.data.organs[0]].name}: farbiges anatomisches Referenzmodell` : undefined}
>
  <Content />
  <OrganGallery organs={post.data.organs} />
</BlogArticle>
