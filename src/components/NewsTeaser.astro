---
import { newsItems } from '../data/news';
---
{newsItems.length > 0 && <section class="sx-section" aria-label="Neuigkeiten"><div class="sx-container"><p class="sx-eyebrow">Neuigkeiten</p><div class="sx-grid">{newsItems.map(item => <article class="sx-card"><h2>{item.title}</h2><p>{item.excerpt}</p><a href={item.href}>Weiterlesen</a></article>)}</div></div></section>}
