---
import untersuchungen from '../data/untersuchungen.json';
import { anzeigename } from '../data/pitch-anzeigenamen';
if (new Set(untersuchungen.map(u => u.id)).size !== untersuchungen.length) throw new Error('Doppelte Untersuchungen');
---
<div class="sx-cg sx-g17">
  {untersuchungen.map(u => <article class="sx-card untersuchung-card" id={`untersuchung-${u.id}`}>
    {u.motiv ? <img src={`/images/diagnostik/${u.id === "fit-for-diving" ? "fit-for-diving-dht" : u.id}.webp`} alt="" loading="lazy" decoding="async" width="640" height="360" /> : <div class="neutral-motif" aria-hidden="true"><svg viewBox="0 0 64 64" width="64" height="64" fill="none" stroke="currentColor" stroke-width="3"><circle cx="32" cy="32" r="25"/><path d="M32 19v26M19 32h26"/></svg></div>}
    <h3>{anzeigename(u.name)}</h3>
    <a class="sx-btn" href={`/diagnostik/${u.id}/`} aria-label={`Details zu ${anzeigename(u.name)}`}>Details ansehen</a>
  </article>)}
</div>
<style>
  .untersuchung-card { position: relative; gap: 1rem; }
  .untersuchung-card .sx-btn { margin-top: auto; }
  .untersuchung-card img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: calc(var(--sx-radius-card) - 6px); transition: filter var(--sx-dur, .22s) var(--sx-ease, ease); }
  .neutral-motif { display: grid; place-items: center; aspect-ratio: 16 / 9; border-radius: var(--sx-radius-card); background: var(--sx-c-bg-soft); color: var(--sx-c-accent); }
  .untersuchung-card a::after { content: ""; position: absolute; inset: 0; }
  .untersuchung-card:focus-within { outline: 3px solid var(--sx-c-accent); outline-offset: 3px; }
  .untersuchung-card h3 { margin: 0; }
  @media (hover: hover) {
    .untersuchung-card:hover img { filter: saturate(1.08) brightness(1.03); }
    .untersuchung-card:hover .sx-btn { border-color: var(--sx-c-accent); color: var(--sx-c-accent); }
  }
  @media (prefers-reduced-motion: reduce) { .untersuchung-card img { transition: none; } }
</style>
