---
// Roadmap — "Was als Nächstes kommt". Vier Schritte vom Prototyp zum Produkt.
// Public-safe (keine Interna). Stil an DhtTimeline angelehnt: nummerierte Karten
// an einer Pulse-roten Leiste, mobil gestapelt, Desktop vierspaltig.
import { roadmapSteps } from '../data/roadmap';

const iconPaths: Record<string, string> = {
  // unify — zwei Flächen, die zusammenlaufen
  unify: 'M4 6h6v12H4zM14 6h6v12h-6zM10 12h4',
  // face — Kopf-Silhouette mit Blickpunkt
  face: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM9 10h.01M15 10h.01M9 15c1 1 5 1 6 0',
  // care — Herz mit Häkchen-Andeutung
  care: 'M12 20s-7-4.5-7-9.5A3.5 3.5 0 0 1 12 8a3.5 3.5 0 0 1 7 2.5c0 5-7 9.5-7 9.5z',
  // launch — Aufwärtspfeil / Start
  launch: 'M12 3l4 6h-3v8h-2V9H8l4-6z',
};
---

<section class="sx-rm sx-section" id="roadmap">
  <div class="sx-container">
    <p class="sx-eyebrow">Was als Nächstes kommt</p>
    <h2 class="sx-title-1 sx-rm__heading">
      Vom Prototyp zum Produkt, das jeder ausprobieren kann.
    </h2>
    <p class="sx-body-lg sx-prose sx-rm__lead">
      Der digitale Gesundheits-Zwilling steht — jetzt wächst er zusammen:
      ein Avatar auf Web und iPhone aus einer Quelle, ein persönliches
      Gesicht aus einem Foto, passende Vorsorge im Kontext und der Schritt
      in die Öffentlichkeit.
    </p>

    <ol class="sx-rm__list" aria-label="Roadmap-Schritte">
      {roadmapSteps.map((step) => (
        <li class="sx-rm__item">
          <div class="sx-rm__node" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d={iconPaths[step.icon]} />
            </svg>
          </div>
          <div class="sx-rm__body">
            <span class="sx-rm__status">{step.status}</span>
            <h3 class="sx-rm__name">{step.name}</h3>
            <p class="sx-rm__tagline">{step.tagline}</p>
            <p class="sx-rm__desc">{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .sx-rm {
    background: var(--sx-c-bg-soft);
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  .sx-rm__heading { max-width: 20ch; }
  .sx-rm__lead { margin-top: 0.75rem; max-width: 62ch; }

  .sx-rm__list {
    list-style: none;
    margin: clamp(2rem, 5vw, 3.25rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    counter-reset: rm;
  }
  @media (min-width: 900px) {
    .sx-rm__list { grid-template-columns: repeat(4, 1fr); }
  }

  .sx-rm__item {
    counter-increment: rm;
    position: relative;
    background: var(--sx-c-surface);
    border: 1px solid var(--sx-c-line);
    border-radius: 16px;
    padding: 1.4rem 1.35rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    box-shadow: var(--sx-shadow-card, 0 1px 2px rgba(16,24,40,.05), 0 10px 28px rgba(16,24,40,.05));
  }
  .sx-rm__item::before {
    content: counter(rm);
    position: absolute;
    top: -12px;
    left: 1.35rem;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--sx-c-accent);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--sx-shadow-pulse);
  }

  .sx-rm__node {
    width: 40px;
    height: 40px;
    color: var(--sx-c-accent);
    margin-top: 0.35rem;
  }
  .sx-rm__node svg { width: 100%; height: 100%; }

  .sx-rm__status {
    display: inline-block;
    align-self: flex-start;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 650;
    color: var(--sx-c-accent);
    background: color-mix(in srgb, var(--sx-c-accent) 12%, transparent);
    padding: 2px 9px;
    border-radius: 999px;
  }
  .sx-rm__name {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.25;
    color: var(--sx-c-ink);
    letter-spacing: -0.01em;
  }
  .sx-rm__tagline {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--sx-c-ink-subtle);
  }
  .sx-rm__desc {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--sx-c-ink-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .sx-rm__item { transition: transform .16s ease, box-shadow .16s ease; }
    .sx-rm__item:hover { transform: translateY(-3px); }
  }
</style>
