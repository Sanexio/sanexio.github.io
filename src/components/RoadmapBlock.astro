---
import { roadmapSteps } from '../data/roadmap';
---
<section class="sx-section sx-soft" id="roadmap"><div class="sx-container">
 <p class="sx-eyebrow">Roadmap</p><h2>Schrittweise entwickeln.<br />Jeden Schritt prüfen.</h2>
 <p class="sx-lead">So planen wir die nächsten Schritte. Jede Phase geht erst in den Einsatz, wenn technische, rechtliche und medizinische Prüfungen abgeschlossen sind.</p>
 <ol class="sx-grid sx-roadmap">{roadmapSteps.map((p,i) => <li class="sx-card"><span class="sx-tag">Schritt {i+1} · Geplant</span><h3>{p.name}</h3><p>{p.description}</p></li>)}</ol>
</div></section>
<style>.sx-roadmap { list-style: none; padding: 0; margin-bottom: 0; }</style>
