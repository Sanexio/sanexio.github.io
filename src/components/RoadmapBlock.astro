---
import data from '../data/sanexiotext.json';
const d = data.roadmap;
---
<section class="sx-section sx-soft" id="roadmap"><div class="sx-container"><p class="sx-eyebrow">Roadmap</p><h2>{d.ueberschrift}</h2><p class="sx-lead">{d.einleitung}</p>
<div class="roadmap-visual"><svg class="path desktop" viewBox="0 0 1200 180" aria-hidden="true"><path class="band b1" d="M70 144 C340 144 820 20 1130 35"/><path class="band b2" d="M70 151 C340 151 820 27 1130 42"/><path class="band b3" d="M70 158 C340 158 820 34 1130 49"/><path class="route" d="M70 140 C340 140 820 16 1130 31"/>{[70,282,494,706,918,1130].map((x,i) => <g><circle class:list={['station',i === 0 && 'current']} cx={x} cy={[140,128,103,73,46,31][i]} r="20"/><text x={x} y={[146,134,109,79,52,37][i]}>{i+1}</text></g>)}</svg>
<p class="location">Du bist hier · 25.11.2026</p><ol class="steps">{d.eintraege.map((p,i) => <li class="step"><svg class="mobile-marker" viewBox="0 0 44 44" aria-hidden="true"><circle class:list={['station',i === 0 && 'current']} cx="22" cy="22" r="19"/><text x="22" y="28">{i+1}</text></svg><article class="sx-card"><span class="sx-tag">{p.zeitraum} · {p.status}</span><h3>{p.titel}</h3><p>{p.text}</p><details><summary>Ergebnisse</summary><ul>{p.ergebnisse.map(e => <li>{e}</li>)}</ul></details></article></li>)}</ol></div><p class="vision">Vision · Longevity, später Human Enhancement</p><p class="sx-note">Ziele sind Pläne, keine Zusagen. Der Twin ist ein Entwicklungsstand mit Beispieldaten und keine diagnostische Anwendung.</p></div></section>
<style>
.roadmap-visual{margin-top:3rem}.path{width:100%;overflow:visible}.route,.band{fill:none;stroke:var(--sx-c-accent);stroke-width:3;stroke-dasharray:8 9}.band{stroke-width:3;opacity:.12;stroke-dasharray:none}.b2{opacity:.2}.b3{opacity:.28}.station{fill:var(--sx-c-surface);stroke:var(--sx-c-accent);stroke-width:3}.station.current{fill:var(--sx-c-accent);animation:pulse 2.5s ease-in-out infinite;transform-box:fill-box;transform-origin:center}.path text,.mobile-marker text{fill:var(--sx-c-accent);text-anchor:middle;font-weight:700;font-size:17px}.path g:first-of-type text,.step:first-child .mobile-marker text{fill:var(--sx-c-on-accent)}.location{color:var(--sx-c-accent);font-weight:700}.steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;list-style:none;padding:0}.step{min-width:0}.step article{height:100%}.step ul{padding-left:1.2rem}.step li{margin-top:.5rem}.mobile-marker{display:none}.vision{margin-top:2rem;font-weight:700;color:var(--sx-c-accent)}@keyframes pulse{50%{transform:scale(1.12)}}@media(max-width:767px){.desktop{display:none}.steps{grid-template-columns:1fr;gap:1.2rem;position:relative}.steps:before{content:'';position:absolute;left:21px;top:20px;bottom:20px;border-left:3px dashed var(--sx-c-accent)}.step{display:grid;grid-template-columns:44px minmax(0,1fr);gap:1rem;position:relative}.mobile-marker{display:block;width:44px;background:var(--sx-c-bg-soft);border-radius:50%}}@media(prefers-reduced-motion:reduce){.station.current{animation:none}}
</style>
