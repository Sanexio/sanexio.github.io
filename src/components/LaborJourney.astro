---
import LaborProgramGrid from './LaborProgramGrid.astro';
import UntersuchungsGrid from './UntersuchungsGrid.astro';
---
<section class="sx-section sx-soft" id="koerperreise" aria-labelledby="koerperreise-title">
  <div class="sx-container">
    <p class="sx-eyebrow">Laborwerte und räumliche Anschauung</p>
    <h2 id="koerperreise-title">Reise durch deinen Körper – in 3D</h2>
    <p class="sx-lead">Laborprogramme und Check-up-Untersuchungen verbinden Messwerte mit dem Blick in den Körper. Auf der Diagnostikseite kannst Du die verfügbaren Organmodelle drehen und näher ansehen.</p>
    <h3>Laborprogramme</h3>
    <LaborProgramGrid />
    <h3>Check-up-Untersuchungen</h3>
    <UntersuchungsGrid />
    <div class="sx-actions"><a class="sx-btn sx-btn-primary" href="/diagnostik/#organ-gallery-title">Drehbare Organe ansehen</a></div>
  </div>
</section>
