---
import LaborProgramGrid from './LaborProgramGrid.astro';
import UntersuchungsGrid from './UntersuchungsGrid.astro';
---
<section class="sx-section sx-soft" id="koerperreise" aria-labelledby="koerperreise-title">
  <div class="sx-container">
    <p class="sx-eyebrow">Der Untersuchungskatalog</p>
    <h2 id="koerperreise-title">Welche Untersuchung zeigt was?</h2>
    <p class="sx-lead">Die Diagnostikseite verbindet 9 Laborprogramme und 17 Check-up-Untersuchungen mit einem Blick in den Körper. Wählen Sie ein Angebot oder drehen und vergrößern Sie die verfügbaren Organmodelle.</p>
    <h3>Laborprogramme</h3>
    <LaborProgramGrid />
    <h3>Check-up-Untersuchungen</h3>
    <UntersuchungsGrid />
    <div class="sx-actions"><a class="sx-btn sx-btn-primary" href="/diagnostik/#organ-gallery-title">Organmodelle in 3D erkunden</a></div>
  </div>
</section>
