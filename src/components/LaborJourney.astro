---
import laborData from '../data/laborprogramme.json';
import LaborVisual from './LaborVisual.astro';
const programmes = laborData.programmes;
if (new Set(programmes.map(p => p.praxis_slug)).size !== programmes.length) throw new Error('Doppelte Laborprogramme');
---
<section class="sx-section sx-soft" id="koerperreise" aria-labelledby="koerperreise-title">
  <div class="sx-container">
    <p class="sx-eyebrow">Laborwerte und räumliche Anschauung</p>
    <h2 id="koerperreise-title">Reise durch deinen Körper – in 3D</h2>
    <p class="sx-lead">Die Laborprogramme verbinden Messwerte mit dem Blick in den Körper. Auf der Laborseite kannst Du die verfügbaren Organmodelle drehen und näher ansehen.</p>
    <div class="sx-grid sx-grid-four">
      {programmes.map(program => <article class="sx-card journey-card">
        <LaborVisual {program} />
        <h3>{program.praxis_name}</h3>
        <a class="sx-btn" href={`/laborprogramme/#${program.praxis_slug}`}>Programm ansehen</a>
      </article>)}
    </div>
    <div class="sx-actions"><a class="sx-btn sx-btn-primary" href="/laborprogramme/#organ-gallery-title">Drehbare Organe ansehen</a></div>
  </div>
</section>
<style>
  .journey-card { display: flex; flex-direction: column; gap: 1rem; padding: 1.5rem; }
  h3 { margin: 0; }
  .journey-card .sx-btn { margin-top: auto; }
</style>
