---
const first = [
 { t: 'Digital Health Twin', k: 'Für Patient:innen', p: 'Die persönliche Gesundheitsakte zeigt Messwerte nach Organ und im Verlauf.', href: '/dht-abnahme-3/', cta: 'Twin mit Beispieldaten testen' },
 // Fußnote 4: Langform laut Nutzerentscheid 27.11.2026 (Nexus/_rules/user-directives.md), „überall immer die Erklärung für Atlas“
 { t: 'Atlas, macOS-App von Sanexio', k: 'Für Ärzt:innen', p: 'Atlas entwirft die Gesprächsnotiz. Erst nach ärztlicher Signatur übernimmt die Praxissoftware den Text.', atlas: true },
 { t: 'Cortex Marketing, macOS-App von Sanexio', k: 'Für Praxen', p: 'Die App automatisiert Kampagnen für Praxis und Sanexio-Marken, etwa mit dem Beitrags-Autopiloten.' },
];
const prod = [
 ['Anbindung an die Praxissoftware','Vorsorgeerinnerungen, Laborprogramme und Abrechnungsregeln im gewohnten Praxissystem.','Alternative zu abonnierten Zusatzmodulen'],
 ['Qualitätsmanagement','Ein gemeinsames Handbuch bündelt Arbeitsabläufe, Hygiene- und Datenschutzpläne.','Alternative zum QM-Abo'],
 ['Dokumente und Verwaltung','Das Team sortiert Befunde und Anfragen und bereitet Schreiben direkt im Praxisnetz vor.','Alternative zum Abo für Dokumentenverwaltung'],
 ['Personal und Dienstplan','Das Praxisteam plant Dienste und erfasst Arbeitszeiten.','Alternative zum Dienstplan-Abo'],
 ['Website und Wartezimmer','Das Team pflegt Website, Online-Terminbuchung und Inhalte für die Wartezimmerbildschirme.','Alternative zu Abos für Website-Baukasten und Wartezimmer-TV'],
];
---
<section class="sx-section" id="apps" aria-labelledby="apps-title"><div class="sx-container">
 <p class="sx-eyebrow">Produkte auf Cortex</p>
 <h2 id="apps-title">Vom Arztgespräch bis zum Dienstplan</h2>
 <p class="sx-lead">Mit Cortex ersetzen wir schrittweise Software-Abos in der Praxis. Erste Anwendungen laufen im Alltag, weitere erproben wir.</p>
 <div class="sx-cg sx-g8">
  {first.map(a => <article class="sx-card"><span class="sx-sub">{a.k}</span>{a.atlas
   ? <h3>Atlas<sup class="sx-fn-ref"><a href="#apps-fn-atlas" id="apps-fn-atlas-ref">4</a></sup>, macOS-App von Sanexio</h3>
   : <h3>{a.t}</h3>}<p>{a.p}</p>{a.href && <a class="sx-btn sx-btn-primary" href={a.href}>{a.cta}</a>}{a.atlas &&
   <ol class="sx-fn-liste" aria-label="Fußnoten"><li id="apps-fn-atlas" value="4"><span>ATLAS steht für „Advanced Thinking, Learning &amp; Assistance System“.</span> <a class="sx-fn-zurueck" href="#apps-fn-atlas-ref" aria-label="Zurück zur Textstelle">↩</a></li></ol>}</article>)}
  {prod.map(([t,p,r]) => <article class="sx-card"><span class="sx-sub">Für Praxen</span><h3>{t}</h3><p>{p}</p><p class="sx-note">{r}</p></article>)}
 </div>
</div></section>
