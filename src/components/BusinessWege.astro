---
import labor from '../data/laborprogramme.json';
import unters from '../data/untersuchungen.json';
import '../styles/businesswege.css';

const progs = Array.isArray(labor) ? labor : Object.values(labor).find(Array.isArray);
if (!progs || !progs.every((p) => typeof p.praxis_name === 'string' && typeof p.praxis_slug === 'string' && Number.isFinite(p.goae_summe_eur))) {
  throw new Error('Laborprogramme fehlen oder enthalten ungültige Preise.');
}
const cent = (wert: number) => Math.round(wert * 100) / 100;
const euro = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' });
const zeilen = [
  { name: 'Check-up (Modellannahme)', preis: 800, quelle: 'annahme' },
  ...progs.map((p) => ({ name: 'Labor · ' + p.praxis_name, preis: p.goae_summe_eur, quelle: 'goae', slug: p.praxis_slug })),
].map((z) => ({ ...z, praxis: cent(z.preis * 0.7), sanexio: cent(z.preis * 0.3) }));
const summen = zeilen.reduce((s, z) => ({ preis: cent(s.preis + z.preis), praxis: cent(s.praxis + z.praxis), sanexio: cent(s.sanexio + z.sanexio) }), { preis: 0, praxis: 0, sanexio: 0 });
const namen = unters.map((u) => u.name).join(', ');
const regler = [
  { id: 'praxen', label: 'Partnerpraxen', min: 1, max: 100, step: 1, value: 11 },
  { id: 'menge', label: 'Buchungen je Praxis und Monat', min: 5, max: 200, step: 5, value: 25 },
  { id: 'anteil', label: 'Sanexio-Anteil je Buchung in %', min: 10, max: 50, step: 5, value: 30, text: '30 %' },
  { id: 'nutzer', label: 'Aktive Twin-Nutzer:innen je Praxis', min: 0, max: 1000, step: 50, value: 300 },
  { id: 'quote', label: 'Anteil mit Twin Plus (9,90 € pro Monat) in %', min: 0, max: 30, step: 1, value: 10, text: '10 %' },
];
const szenarien = [
  { id: 'start', text: 'Start 2027 · nur Partner Nr. 1' },
  { id: 'basis28', text: '2028 · Basis' },
  { id: 'konservativ', text: '2029 · konservativ' },
  { id: 'basis29', text: '2029 · Basis' },
  { id: 'ambitioniert', text: '2029 · ambitioniert' },
];
const zukunftRegler = [
  { id: 'wachstum', label: 'Neue Partnerpraxen pro Jahr', min: 0, max: 50, step: 1, value: 10, text: '10' },
  { id: 'kosten', label: 'Jährliche Fixkosten von Sanexio in €', min: 100000, max: 3000000, step: 50000, value: 600000, text: euro.format(600000) },
];
const mitbauRegler = [
  { id: 'entwickler', label: 'Beteiligte Entwickler:innen und Ärzt:innen', min: 0, max: 500, step: 10, value: 40, text: '40' },
  { id: 'stunden', label: 'Stunden je Person und Monat', min: 1, max: 40, step: 1, value: 4, text: '4' },
  { id: 'satz', label: 'Angesetzter Wert je Stunde in €', min: 50, max: 150, step: 5, value: 90, text: euro.format(90) },
];
const kreditRegler = [
  { id: 'kredit', label: 'Kreditsumme in €', min: 100000, max: 3000000, step: 50000, value: 1000000, text: euro.format(1000000) },
  { id: 'zins', label: 'Zinssatz in %', min: 2, max: 12, step: 0.5, value: 7, text: '7,0 %' },
  { id: 'jahre', label: 'Laufzeit in Jahren', min: 3, max: 10, step: 1, value: 5, text: '5 Jahre' },
];
const crowdRegler = [
  { id: 'leute', label: 'Unterstützer:innen', min: 100, max: 20000, step: 100, value: 2000, text: '2.000' },
  { id: 'beitrag', label: 'Beitrag je Person in €', min: 10, max: 500, step: 1, value: 79, text: euro.format(79) },
];
---
<section id="vermittlung" class="sx-section"><div class="sx-container">
  <p class="sx-eyebrow">Buchung und Abrechnung</p>
  <h2>Über Sanexio buchen, in der Partnerpraxis untersuchen lassen</h2>
  <p class="sx-lead">Partnerpraxen sollen ihre Untersuchungen über Sanexio anbieten können. Im Modell erhält die Praxis 70 % des Preises, Sanexio 30 %.</p>
  <ol class="sx-bw-flow">
    <li class="sx-card"><span class="sx-step">1 ·</span><h3>Termin buchen</h3><p>Patient:innen wählen Untersuchung, Praxis und Termin. Im Modell zahlen sie bei der Buchung an Sanexio.</p></li>
    <li class="sx-card"><span class="sx-step">2 ·</span><h3>Untersuchung in der Praxis</h3><p>Die Partnerpraxis untersucht und berät. Die ärztliche Verantwortung und die medizinischen Daten bleiben bei ihr.</p></li>
    <li class="sx-card"><span class="sx-step">3 ·</span><h3>Praxisanteil auszahlen</h3><p>Nach der Untersuchung erhält die Praxis im Modell 70 %. Die übrigen 30 % sollen die Plattform, den Twin und die Entwicklung von Nexus finanzieren.</p></li>
  </ol>
  <h3 class="sx-h3-gap">Erlös pro Untersuchung im Kooperationsmodell</h3>
  <div class="sx-card sx-card-breit"><div class="sx-table-wrap"><table class="sx-table sx-bw-tabelle">
    <thead><tr><th scope="col">Untersuchung</th><th scope="col">Preis</th><th scope="col">Partnerpraxis 70 %</th><th scope="col">Sanexio 30 %</th></tr></thead>
    <tbody>{zeilen.map((z) => <tr><th scope="row">{z.name}</th><td>{euro.format(z.preis)}</td><td>{euro.format(z.praxis)}</td><td>{euro.format(z.sanexio)}</td></tr>)}</tbody>
    <tfoot><tr><th scope="row">Summe bei je einer Buchung</th><td>{euro.format(summen.preis)}</td><td>{euro.format(summen.praxis)}</td><td>{euro.format(summen.sanexio)}</td></tr></tfoot>
  </table></div></div>
  <p class="sx-slide-note">Je nach Ausstattung der Partnerpraxis kommen weitere Untersuchungen infrage. Dazu zählen Spirometrie, Belastungs-EKG, Eye Check, Carotis-Duplex, Echokardiographie, Tauchtauglichkeit, Body-Check, Kardio-Check, Komplett-Check und Gesundheits-Check (FINDRISK, Herz-Kreislauf-Risiko, Leber). Beim Ultraschall sind Bauchorgane, Bauchspeicheldrüse, Leber und Gallenblase, Nieren und Harnwege, Prostata und Harnblase, Schilddrüse sowie ein Komplett-Check vorgesehen. Die Preise sind offen.</p>
  <p class="sx-slide-note sx-slide-note-2">Laborpreise nach GOÄ (Summe je Programm). {labor.disclaimer_sie}</p>
</div></section>
<section id="rechner" class="sx-section sx-soft"><div class="sx-container">
  <p class="sx-eyebrow">Interaktiver Erlösrechner</p>
  <h2>Was bringen zehn weitere Praxen oder fünf zusätzliche Checks?</h2>
  <p class="sx-lead">Wählen Sie ein Szenario oder ändern Sie die Annahmen für den Jahreserlös.</p>
  <div class="sx-bw-szenarien" role="group" aria-label="Szenario wählen">
    {szenarien.map((s) => <button type="button" class="sx-bw-szenario" data-bw-szenario={s.id} aria-pressed="false">{s.text}</button>)}
  </div>
  <p class="sx-note">Das Modell rechnet mit einem Check pro Person und Jahr, anfangs 800 aktiven Personen in der ersten Praxis und 300 je weiterer Praxis. Der Rechner nutzt den Durchschnittspreis Ihrer Auswahl.</p>
  <div class="sx-bw-rechner" data-bw-rechner>
    <div class="sx-card sx-bw-regler">
      {regler.map((r) => <div><label for={'bw-' + r.id}>{r.label}</label><input id={'bw-' + r.id} type="range" class="sx-bw-range" min={r.min} max={r.max} step={r.step} value={r.value} data-bw={r.id} /><output for={'bw-' + r.id} data-bw-out={r.id}>{r.text ?? r.value}</output></div>)}
      <p class="sx-note">Ausgangspunkt sind 30 % für Sanexio. Testen Sie eine andere Aufteilung.</p>
      <fieldset class="sx-bw-mix"><legend>Welche Untersuchungen werden gebucht?</legend>
        {zeilen.map((z) => <label><input type="checkbox" data-bw-preis={z.preis} checked /> {z.name}</label>)}
      </fieldset>
    </div>
    <div class="sx-card sx-bw-ergebnis" aria-live="polite">
      <span class="sx-sub">Jahreswerte</span>
      <div class="sx-bw-out"><span class="sx-number" data-bw-out="umsatz"></span><p>Gesamtwert der vermittelten Untersuchungen</p></div>
      <div class="sx-bw-out sx-bw-out-s"><span class="sx-number" data-bw-out="sanexio"></span><p>Anteil von Sanexio an den Buchungen (<span data-bw-out="anteil-text">30</span> %)</p></div>
      <div class="sx-bw-out"><span class="sx-number" data-bw-out="praxis"></span><p>Anteil der Partnerpraxen an den Buchungen (<span data-bw-out="praxis-text">70</span> %)</p></div>
      <div class="sx-bw-out"><span class="sx-number" data-bw-out="twinplus"></span><p>Aboerlöse aus Twin Plus für Sanexio</p></div>
      <div class="sx-bw-out sx-bw-out-s sx-bw-summe"><span class="sx-number" data-bw-out="gesamt"></span><p>Jahreserlös für Sanexio insgesamt</p></div>
      <div class="sx-bw-bar" role="img" data-bw-bar aria-label="30 % Sanexio, 70 % Partnerpraxen"><i class="sx-bw-bar-s" style="width:30%"></i><i class="sx-bw-bar-p" style="width:70%"></i></div>
      <p class="sx-note">Durchschnittspreis der ausgewählten Untersuchungen: <span data-bw-out="schnitt"></span></p>
    </div>
  </div>
  <p class="sx-slide-note">Die Startwerte sind Beispiele. Das Umsatzmodell weiter unten rechnet mit einem Check-up für 800 €.</p>
</div></section>
<section id="zukunft-rechner" class="sx-section"><div class="sx-container">
  <p class="sx-eyebrow">Fünfjahresmodell</p>
  <h2>Wann decken die Erlöse unsere Fixkosten?</h2>
  <p class="sx-lead">Der Erlösrechner liefert die Werte fürs Startjahr. Stellen Sie ein, wie viele Praxen jährlich hinzukommen und welche Fixkosten Sanexio trägt.</p>
  <div class="sx-bw-rechner" data-bw-zukunft>
    <div class="sx-card sx-bw-regler">
      {zukunftRegler.map((r) => <div><label for={'bw-' + r.id}>{r.label}</label><input id={'bw-' + r.id} type="range" class="sx-bw-range" min={r.min} max={r.max} step={r.step} value={r.value} data-bw={r.id} /><output for={'bw-' + r.id} data-bw-out={r.id}>{r.text}</output></div>)}
      <p class="sx-note">Die Fixkosten sind ein frei wählbarer Beispielwert.</p>
    </div>
    <div class="sx-card sx-bw-ergebnis">
      <span class="sx-sub">Sanexio-Erlös von 2027 bis 2031</span>
      <div class="sx-bw-jahre" role="img" data-bw-jahre aria-label="Erlös je Jahr">
        {Array.from({ length: 5 }, (_, j) => <div class="sx-bw-jahr"><span class="sx-bw-jahr-wert" data-bw-out={'jahr-' + j}></span><i data-bw-saeule={j}></i><span class="sx-bw-jahr-name">{2027 + j}</span></div>)}
      </div>
      <p class="sx-bw-satz">Summe in fünf Jahren: <strong data-bw-out="summe5"></strong>. Ergebnis im Jahr 2031 nach festen Kosten: <strong data-bw-out="ergebnis5"></strong>.</p>
      <p class="sx-bw-satz">Gewinnschwelle: ab <strong data-bw-out="schwelle"></strong> Partnerpraxen.</p>
    </div>
  </div>
  <div class="sx-bw-teilen"><button type="button" class="sx-btn" data-bw-teilen>Link zu diesem Szenario kopieren</button><span class="sx-note" data-bw-out="teilen" aria-live="polite"></span></div>
</div></section>
<section id="wege" class="sx-section"><div class="sx-container">
  <p class="sx-eyebrow">Finanzierung</p>
  <h2>Zwei Wege, den Aufbau von Sanexio zu finanzieren</h2>
  <p class="sx-lead">Wählen Sie einen Finanzierungsweg.</p>
  <div class="sx-bw-kern">In beiden Varianten betreibt die Sanexio GmbH Nexus und behält Modellgewichte und Feintuning im Haus. Für das Training sind pseudonymisierte Daten vorgesehen.</div>
  <div class="sx-bw-switch" role="tablist" aria-label="Finanzierungsweg">
    <button id="bw-tab-a" type="button" role="tab" class="sx-bw-tab" data-bw-tab="a" aria-selected="true" aria-controls="bw-weg-a"><span class="sx-sub">Weg A ·</span><strong>Fremdkapital für Sanexio</strong></button>
    <button id="bw-tab-b" type="button" role="tab" class="sx-bw-tab" data-bw-tab="b" aria-selected="false" aria-controls="bw-weg-b"><span class="sx-sub">Weg B ·</span><strong>Open Source und Crowdfunding</strong></button>
  </div>
  <div class="sx-bw-weg sx-bw-weg-a" id="bw-weg-a" role="tabpanel" aria-labelledby="bw-tab-a">
    <h3>Ein Darlehen für den Aufbau, Rückzahlung aus laufenden Erlösen</h3>
    <div class="sx-cg sx-g3">
      <article class="sx-card"><span class="sx-sub">Wofür wir das Kapital einsetzen</span><p>Vorgesehen sind verschlüsselter, gespiegelter Speicher, Trainingshardware, regulatorische Gutachten und Zeit für die ärztliche Prüfung.</p></article>
      <article class="sx-card"><span class="sx-sub">Woher die Rückzahlung kommen soll</span><p>Patient:innen zahlen im Modell bei der Buchung. Unser Anteil von 30 % je erbrachter Untersuchung soll zur Rückzahlung beitragen.</p></article>
      <article class="sx-card"><span class="sx-sub">Worauf der Aufbau beruht</span><p>Die erste Partnerpraxis dokumentiert seit 1997 Behandlungsverläufe. Sanexio entwickelt Nexus.</p></article>
    </div>
    <div class="sx-card sx-bw-mini" data-bw-kredit>
      {kreditRegler.map((r) => <div><label for={'bw-' + r.id}>{r.label}</label><input id={'bw-' + r.id} type="range" class="sx-bw-range" min={r.min} max={r.max} step={r.step} value={r.value} data-bw={r.id} /><output for={'bw-' + r.id} data-bw-out={r.id}>{r.text}</output></div>)}
      <p class="sx-bw-satz">Jährliche Rate: <strong data-bw-out="rate"></strong>. Das entspricht rund <strong data-bw-out="rate-u"></strong> vermittelten Untersuchungen pro Monat.</p>
      <p class="sx-bw-satz">Zinsen über die ganze Laufzeit: <strong data-bw-out="zinsen"></strong>.</p>
      <p class="sx-bw-satz">Die Rate entspricht <strong data-bw-out="rate-anteil"></strong> des Sanexio-Erlöses im Startjahr.</p>
      <div class="sx-bw-meter" role="img" data-bw-meter="rate" aria-label="Anteil der Rate am Erlös"><i></i></div>
    </div>
    <p class="sx-slide-note">Beispielwerte. Die Konditionen ergeben sich aus dem Darlehensangebot.</p>
    <a class="sx-btn sx-btn-primary" href="mailto:s.stracke@sanexio.de?subject=Sanexio%20Fremdkapital">Finanzierungsgespräch vereinbaren</a>
  </div>
  <div class="sx-bw-weg sx-bw-weg-b" id="bw-weg-b" role="tabpanel" aria-labelledby="bw-tab-b">
    <h3>Die Community finanziert und entwickelt mit</h3>
    <div class="sx-cg sx-g3">
      <article class="sx-card"><span class="sx-sub">Was wir öffnen wollen</span><p>Cortex, Teile der KI-Steuerung und die Praxis-Apps sollen unter einer offenen Lizenz erscheinen. Praxen und Entwickler:innen könnten den Code so prüfen, nutzen und weiterentwickeln.</p></article>
      <article class="sx-card"><span class="sx-sub">Was Sanexio selbst betreibt</span><p>Nexus mit Modell, Gewichten und Trainingsdaten bleibt bei Sanexio, ebenso die Marke und die Buchungsplattform. Über diese Plattform sollen laufende Erlöse entstehen.</p></article>
      <article class="sx-card"><span class="sx-sub">Wie Sie mitmachen können</span><p>Sie können Geld, ärztliches Fachwissen oder Code beitragen. Wer früh mitmacht, soll den Twin vorab testen können.</p></article>
    </div>
    <div class="sx-card sx-bw-mini" data-bw-crowd>
      {crowdRegler.map((r) => <div><label for={'bw-' + r.id}>{r.label}</label><input id={'bw-' + r.id} type="range" class="sx-bw-range" min={r.min} max={r.max} step={r.step} value={r.value} data-bw={r.id} /><output for={'bw-' + r.id} data-bw-out={r.id}>{r.text}</output></div>)}
      <p class="sx-bw-satz">Zusammen: <strong data-bw-out="crowd"></strong>. Das deckt rund <strong data-bw-out="crowd-m"></strong> Monate Vermittlungsanteil im Rechner oben.</p>
    </div>
    <h3 class="sx-h3-gap">Was die Mitarbeit der Community wert sein kann</h3>
    <div class="sx-card sx-bw-mini" data-bw-mitbau>
      {mitbauRegler.map((r) => <div><label for={'bw-' + r.id}>{r.label}</label><input id={'bw-' + r.id} type="range" class="sx-bw-range" min={r.min} max={r.max} step={r.step} value={r.value} data-bw={r.id} /><output for={'bw-' + r.id} data-bw-out={r.id}>{r.text}</output></div>)}
      <p class="sx-bw-satz">Wert der Mitarbeit pro Jahr: <strong data-bw-out="mitbau"></strong>. Zusammen mit dem Crowdfunding: <strong data-bw-out="community"></strong>.</p>
    </div>
    <p class="sx-slide-note">Die Werte sind Beispiele. Für eine Beteiligung per Crowdinvesting prüfen wir vor dem Start die rechtlichen Vorgaben.</p>
    <a class="sx-btn sx-btn-primary" href="mailto:s.stracke@sanexio.de?subject=Sanexio%20Community">In der Community mitmachen</a>
    <a class="sx-btn" href="/blog/mitbauen-wie-nutzer-den-dht-mitgestalten/">So gestalten Sie den Twin mit</a>
  </div>
  <h3 class="sx-h3-gap">Die Finanzierungswege im Vergleich</h3>
  <div class="sx-card sx-card-breit"><div class="sx-table-wrap"><table class="sx-table sx-bw-vergleich">
    <thead><tr><th scope="col"></th><th scope="col">Weg A · Fremdkapital</th><th scope="col">Weg B · Open Source und Crowdfunding</th></tr></thead>
    <tbody>
      <tr><th scope="row">Kapital</th><td data-bw-out="v-kredit"></td><td data-bw-out="v-community"></td></tr>
      <tr><th scope="row">Kapitalkosten</th><td data-bw-out="v-zinsen"></td><td>Zinsfrei, mit frühem Zugang und offener Software als Gegenleistung</td></tr>
      <tr><th scope="row">Rückzahlung</th><td data-bw-out="v-rate"></td><td>Keine</td></tr>
      <tr><th scope="row">Eigentum an Nexus</th><td>100 % Sanexio GmbH</td><td>100 % Sanexio GmbH</td></tr>
      <tr><th scope="row">Verfügbarkeit</th><td>Nach Vertragsabschluss</td><td>Schrittweise mit den Beiträgen der Community</td></tr>
    </tbody>
  </table></div></div>
  <p class="sx-slide-note">Die berechneten Beträge folgen Ihren Einstellungen.</p>
</div></section>
<script>
  const ganz = new Intl.NumberFormat('de-DE', { maximumFractionDigits: 0 });
  const dezimal = new Intl.NumberFormat('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const millionen = new Intl.NumberFormat('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const geld = (wert: number) => wert >= 1000000 ? `${millionen.format(wert / 1000000)} Mio. €` : `${ganz.format(wert)} €`;
  const wert = (name: string) => Number(document.querySelector<HTMLInputElement>(`[data-bw="${name}"]`)?.value ?? 0);
  function ausgabe(name: string, text: string) {
    document.querySelectorAll<HTMLElement>(`[data-bw-out="${name}"]`).forEach((el) => { el.textContent = text; });
  }
  const eingaben = Array.from(document.querySelectorAll<HTMLInputElement>('[data-bw]'));
  const mix = Array.from(document.querySelectorAll<HTMLInputElement>('[data-bw-preis]'));
  const szenarioButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-bw-szenario]'));
  const szenarioWerte: Record<string, number[]> = {
    start: [1, 65, 800, 10], basis28: [11, 25, 300, 10],
    konservativ: [26, 25, 300, 10], basis29: [51, 25, 300, 10], ambitioniert: [100, 25, 300, 10],
  };
  function durchschnitt() {
    const preise = mix.filter((el) => el.checked).map((el) => Number(el.dataset.bwPreis));
    return preise.length ? preise.reduce((summe, preis) => summe + preis, 0) / preise.length : 0;
  }
  function erloes(praxen: number) {
    const anteilQ = wert('anteil') / 100;
    const umsatz = praxen * wert('menge') * 12 * durchschnitt();
    const vermittlung = umsatz * anteilQ;
    const praxis = umsatz * (1 - anteilQ);
    const twinplus = praxen * wert('nutzer') * (wert('quote') / 100) * 9.90 * 12;
    return { umsatz, vermittlung, praxis, twinplus, gesamt: vermittlung + twinplus };
  }
  function vorzeichen(el: HTMLElement, positiv: boolean) {
    el.classList.toggle('sx-bw-plus', positiv);
    el.classList.toggle('sx-bw-minus', !positiv);
  }
  function rechnen() {
    const schnitt = durchschnitt();
    const anteil = wert('anteil');
    const anteilQ = anteil / 100;
    const { umsatz, vermittlung, praxis, twinplus, gesamt: sanexioGesamt } = erloes(wert('praxen'));
    eingaben.forEach((el) => {
      const name = el.dataset.bw!;
      const zahl = Number(el.value);
      const text = ['kredit', 'beitrag', 'kosten', 'satz'].includes(name) ? geld(zahl)
        : name === 'zins' ? `${dezimal.format(zahl)} %`
        : ['anteil', 'quote'].includes(name) ? `${ganz.format(zahl)} %`
        : name === 'jahre' ? `${ganz.format(zahl)} Jahre` : ganz.format(zahl);
      ausgabe(name, text);
    });
    ausgabe('umsatz', geld(umsatz));
    ausgabe('sanexio', geld(vermittlung));
    ausgabe('praxis', geld(praxis));
    ausgabe('twinplus', geld(twinplus));
    ausgabe('gesamt', geld(sanexioGesamt));
    ausgabe('anteil-text', ganz.format(anteil));
    ausgabe('praxis-text', ganz.format(100 - anteil));
    ausgabe('schnitt', geld(schnitt));
    const bar = document.querySelector<HTMLElement>('[data-bw-bar]');
    if (bar) {
      bar.setAttribute('aria-label', `${anteil} % Sanexio, ${100 - anteil} % Partnerpraxen`);
      const teile = bar.querySelectorAll<HTMLElement>('i');
      teile[0].style.width = `${anteil}%`;
      teile[1].style.width = `${100 - anteil}%`;
    }
    const jahre = Array.from({ length: 5 }, (_, j) => erloes(wert('praxen') + wert('wachstum') * j).gesamt);
    const maximum = Math.max(...jahre);
    jahre.forEach((ertrag, j) => {
      ausgabe(`jahr-${j}`, geld(ertrag));
      const saeule = document.querySelector<HTMLElement>(`[data-bw-saeule="${j}"]`);
      if (saeule) {
        saeule.style.height = `${maximum ? ertrag / maximum * 100 : 0}%`;
        vorzeichen(saeule, ertrag >= wert('kosten'));
      }
    });
    document.querySelector('[data-bw-jahre]')?.setAttribute('aria-label', `Erlös je Jahr: ${jahre.map((ertrag, j) => `${2027 + j}: ${geld(ertrag)}`).join(', ')}`);
    ausgabe('summe5', geld(jahre.reduce((summe, ertrag) => summe + ertrag, 0)));
    const ergebnis5 = jahre[4] - wert('kosten');
    ausgabe('ergebnis5', `${ergebnis5 >= 0 ? '+' : '−'}${geld(Math.abs(ergebnis5))}`);
    document.querySelectorAll<HTMLElement>('[data-bw-out="ergebnis5"]').forEach((el) => vorzeichen(el, ergebnis5 >= 0));
    const erloesJePraxis = sanexioGesamt / wert('praxen');
    ausgabe('schwelle', erloesJePraxis ? ganz.format(Math.ceil(wert('kosten') / erloesJePraxis)) : '–');
    const q = wert('zins') / 100;
    const rate = wert('kredit') * q / (1 - Math.pow(1 + q, -wert('jahre')));
    const zinsen = rate * wert('jahre') - wert('kredit');
    const rateAnteil = sanexioGesamt ? rate / sanexioGesamt * 100 : null;
    ausgabe('rate', geld(rate));
    ausgabe('rate-u', schnitt ? ganz.format(Math.ceil(rate / 12 / (schnitt * anteilQ))) : '–');
    ausgabe('zinsen', geld(zinsen));
    ausgabe('rate-anteil', rateAnteil === null ? '–' : `${ganz.format(rateAnteil)} %`);
    const meter = document.querySelector<HTMLElement>('[data-bw-meter="rate"]');
    if (meter) {
      const fuellung = meter.querySelector<HTMLElement>('i');
      if (fuellung) fuellung.style.width = `${Math.min(100, rateAnteil ?? 100)}%`;
      vorzeichen(meter, rateAnteil !== null && rateAnteil < 100);
      meter.setAttribute('aria-label', `Anteil der Rate am Erlös: ${rateAnteil === null ? '–' : `${ganz.format(rateAnteil)} %`}`);
    }
    const crowd = wert('leute') * wert('beitrag');
    const mitbau = wert('entwickler') * wert('stunden') * 12 * wert('satz');
    const community = crowd + mitbau;
    ausgabe('crowd', geld(crowd));
    ausgabe('crowd-m', sanexioGesamt ? dezimal.format(crowd / (sanexioGesamt / 12)) : '–');
    ausgabe('mitbau', geld(mitbau));
    ausgabe('community', geld(community));
    ausgabe('v-kredit', geld(wert('kredit')));
    ausgabe('v-community', geld(community));
    ausgabe('v-zinsen', geld(zinsen));
    ausgabe('v-rate', `${geld(rate)} im Jahr`);
  }
  function manuell() {
    szenarioButtons.forEach((button) => button.setAttribute('aria-pressed', 'false'));
    ausgabe('teilen', '');
    rechnen();
  }
  [...eingaben, ...mix].forEach((el) => {
    el.addEventListener('input', manuell);
    el.addEventListener('change', manuell);
  });
  szenarioButtons.forEach((button) => button.addEventListener('click', () => {
    const werte = szenarioWerte[button.dataset.bwSzenario ?? ''];
    if (!werte) return;
    ['praxen', 'menge', 'nutzer', 'quote'].forEach((name, i) => {
      const el = eingaben.find((el) => el.dataset.bw === name);
      if (el) el.value = String(werte[i]);
    });
    szenarioButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
    ausgabe('teilen', '');
    rechnen();
  }));
  function laden() {
    if (!location.hash.startsWith('#bw=')) return;
    location.hash.slice(4).split(',').forEach((paar) => {
      const [name, roh] = paar.split(':');
      if (name === 'mix') {
        if (roh && /^[01]+$/.test(roh) && roh.length === mix.length) mix.forEach((el, i) => { el.checked = roh[i] === '1'; });
        return;
      }
      const el = eingaben.find((el) => el.dataset.bw === name);
      if (!el || !roh || !/^[+-]?(?:\d+(?:\.\d*)?|\.\d+)$/.test(roh)) return;
      const zahl = Number(roh);
      if (Number.isFinite(zahl)) el.value = String(Math.min(Number(el.max), Math.max(Number(el.min), zahl)));
    });
  }
  document.querySelector<HTMLButtonElement>('[data-bw-teilen]')?.addEventListener('click', async () => {
    const werte = eingaben.map((el) => `${el.dataset.bw}:${el.value}`);
    werte.push(`mix:${mix.map((el) => el.checked ? '1' : '0').join('')}`);
    history.replaceState(null, '', `#bw=${werte.join(',')}`);
    try {
      await navigator.clipboard.writeText(location.href);
      ausgabe('teilen', 'Link kopiert');
    } catch {
      ausgabe('teilen', 'Link steht in der Adresszeile');
    }
  });
  laden();
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-bw-tab]'));
  function waehlen(tab: HTMLButtonElement) {
    tabs.forEach((t) => {
      const aktiv = t === tab;
      t.setAttribute('aria-selected', String(aktiv));
      t.tabIndex = aktiv ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !aktiv;
    });
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => waehlen(tab));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const ziel = tabs[(index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
      waehlen(ziel);
      ziel.focus();
    });
  });
  if (tabs[0]) waehlen(tabs[0]);
  rechnen();
</script>
