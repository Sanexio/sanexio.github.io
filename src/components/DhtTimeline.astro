---
import data from '../data/sanexiotext.json';
const d = data.dht;
---
<section class="sx-section" id="dht"><div class="sx-container">
 <p class="sx-eyebrow">Digital Health Twin</p><h2>{d.ueberschrift}</h2><p class="sx-lead">{d.einleitung}</p>
 <p><a class="sx-btn" href="/dht-abnahme-3/">DHT testen – mit Beispieldaten</a></p>
 <div class="sx-grid sx-grid-three">{d.punkte.map(p => <article class="sx-card"><h3>{p.titel}</h3><p>{p.text}</p></article>)}</div>
 <p class="sx-note" style="margin-top: 1.5rem">Der Twin befindet sich in Entwicklung. Er ersetzt keine ärztliche Untersuchung und keine ärztliche Entscheidung.</p>
</div></section>
