---
interface Props { nur?: string[] }
const { nur } = Astro.props;
// Abschnitte einzeln platzierbar: <Baustein nur={['id']} /> zeigt nur die genannten.
const zeig = (id: string) => !nur || nur.includes(id);
---
{zeig('cortex') && (<section class="sx-section" id="cortex" aria-labelledby="f6"><div class="sx-container">
 <p class="sx-eyebrow">Cortex und Nexus</p>
 <h2 id="f6">Wie wir KI in die Praxis bringen</h2>
 <div class="sx-cg sx-g2">
  <article class="sx-card"><span class="sx-sub">Cortex</span><h3>Unsere Plattform</h3><p>Cortex nutzt Open-Source-Modelle, die beim Nutzer laufen und ihm gehören. Kein Abo, keine Abhängigkeit von einem großen Anbieter, keine Daten in fremder Cloud.</p></article>
  <article class="sx-card"><span class="sx-sub">Nexus</span><h3>Unser medizinisches Modell</h3><p>Modelle mit offenen Gewichten wie Qwen laufen heute auf unseren Rechnern. Wir passen sie an unser medizinisches Wissen an.</p><p>Unser Ziel sind eigene Modellgewichte. Dafür wollen wir in Deutschland auf unserem Server mit pseudonymisierten Praxisverläufen trainieren.</p></article>
 </div>
 <div class="sx-cg sx-g3">
  <article class="sx-card"><span class="sx-sub">Kontrolle vor Ort</span><p>Patient:innen entscheiden selbst, wer ihre Daten sieht.</p></article>
  <article class="sx-card"><span class="sx-sub">Unabhängigkeit</span><p>Preise und Ausfälle externer KI-Dienste beeinflussen den lokalen Betrieb nicht.</p></article>
  <article class="sx-card"><span class="sx-sub">Datenschutz</span><p>Patientendaten verlassen nie Praxis oder iPhone.</p></article>
 </div>
 <figure class="sx-role-figure">
  <svg class="sx-role-diagram sx-role-hoch" viewBox="0 0 360 540" role="img" aria-labelledby="role-title role-desc" xmlns="http://www.w3.org/2000/svg">
   <title id="role-title">Cortex verbindet. Nexus verarbeitet.</title>
   <desc id="role-desc">Die Sanexio GmbH bildet den Rahmen. Cortex verbindet als Plattform und App-Store Apps, Praxen und Patienten. Nexus verarbeitet Daten lokal mit Nexus-KI und MLX. Zwischen Cortex und Nexus fließen Daten und Aufträge.</desc>
   <rect class="frame" x="1" y="1" width="358" height="538" rx="22" />
   <circle class="accent" cx="31" cy="34" r="5" />
   <text class="label" x="47" y="39">SANEXIO GMBH</text>
   <text class="small" x="25" y="66">Unternehmen hinter der Entwicklung</text>
   <rect class="panel" x="20" y="88" width="320" height="140" rx="16" />
   <text class="kicker" x="38" y="117">PLATTFORM &amp; APP-STORE</text>
   <text class="heading" x="38" y="151">Cortex verbindet.</text>
   <g class="chips"><rect x="38" y="171" width="66" height="38" rx="19"/><rect x="111" y="171" width="79" height="38" rx="19"/><rect x="197" y="171" width="105" height="38" rx="19"/></g>
   <g class="chip-text"><text x="71" y="195">Apps</text><text x="150" y="195">Praxen</text><text x="249" y="195">Patienten</text></g>
   <g transform="translate(0 -36)">
   <path class="flow" d="M70 278v54m0 0-6-7m6 7 6-7M290 332v-54m0 0-6 7m6-7 6 7" />
   <rect class="flow-label-bg" x="91" y="291" width="178" height="28" rx="14" />
   <text class="flow-label" x="180" y="310">Daten &amp; Aufträge</text>
   <rect class="panel" x="20" y="346" width="320" height="175" rx="16" />
   <text class="kicker" x="38" y="375">ENGINE</text>
   <text class="heading" x="38" y="409">Nexus verarbeitet.</text>
   <text class="body" x="38" y="437">Daten werden lokal verarbeitet.</text>
   <g class="chips"><rect x="38" y="456" width="101" height="38" rx="19"/><rect x="146" y="456" width="69" height="38" rx="19"/></g>
   <g class="chip-text"><text x="88" y="480">Nexus-KI</text><text x="180" y="480">MLX</text></g>
   <text class="small" x="25" y="556">Getrennte Rollen. Gemeinsam verbunden.</text>
   </g>
  </svg>
  <svg class="sx-role-diagram sx-role-quer" viewBox="0 0 960 370" role="img" aria-labelledby="role-title-q role-desc-q" xmlns="http://www.w3.org/2000/svg">
   <title id="role-title-q">Cortex verbindet. Nexus verarbeitet.</title>
   <desc id="role-desc-q">Die Sanexio GmbH bildet den Rahmen. Cortex verbindet als Plattform und App-Store Apps, Praxen und Patienten. Nexus verarbeitet Daten lokal mit Nexus-KI und MLX. Zwischen Cortex und Nexus fließen Daten und Aufträge.</desc>
   <rect class="frame" x="1" y="1" width="958" height="368" rx="22" />
   <circle class="accent" cx="31" cy="36" r="5" />
   <text class="label" x="47" y="41">SANEXIO GMBH</text>
   <text class="small" x="25" y="66">Unternehmen hinter der Entwicklung</text>
   <rect class="panel" x="24" y="88" width="380" height="210" rx="16" />
   <text class="kicker" x="44" y="122">PLATTFORM &amp; APP-STORE</text>
   <text class="heading" x="44" y="160">Cortex verbindet.</text>
   <g class="chips"><rect x="44" y="232" width="66" height="38" rx="19"/><rect x="117" y="232" width="79" height="38" rx="19"/><rect x="203" y="232" width="105" height="38" rx="19"/></g>
   <g class="chip-text"><text x="77" y="256">Apps</text><text x="156" y="256">Praxen</text><text x="255" y="256">Patienten</text></g>
   <path class="flow" d="M418 160H542m0 0-7-6m7 6-7 6M542 238H418m0 0 7-6m-7 6 7 6" />
   <rect class="flow-label-bg" x="412" y="185" width="136" height="28" rx="14" />
   <text class="flow-label" x="480" y="204">Daten &amp; Aufträge</text>
   <rect class="panel" x="556" y="88" width="380" height="210" rx="16" />
   <text class="kicker" x="576" y="122">ENGINE</text>
   <text class="heading" x="576" y="160">Nexus verarbeitet.</text>
   <text class="body" x="576" y="192">Daten werden lokal verarbeitet.</text>
   <g class="chips"><rect x="576" y="232" width="101" height="38" rx="19"/><rect x="684" y="232" width="69" height="38" rx="19"/></g>
   <g class="chip-text"><text x="626" y="256">Nexus-KI</text><text x="718" y="256">MLX</text></g>
   <text class="small" x="25" y="340">Getrennte Rollen. Gemeinsam verbunden.</text>
  </svg>
 </figure>
 <p class="sx-slide-note">Cortex läuft vor Ort. Die eigenen Nexus-Gewichte bleiben bei Sanexio.</p>
</div></section>)}

{zeig('edge') && (<section class="sx-section" id="edge" aria-labelledby="f5"><div class="sx-container">
 <p class="sx-eyebrow">Was wir anders machen</p>
 <h2 id="f5">Wir sind nicht SaaS. Wir geben Usern die Kontrolle zurück!</h2>
 <p class="sx-lead">Wir sind EDGE: Die KI kommt zu den Daten, nie die Daten zur KI.</p>
 <p class="sx-note">EDGE – The AI comes to the data. Never the other way round.</p>
 <div class="sx-cg sx-g4">
  <article class="sx-card"><span class="sx-number">E</span><h3>Edge Inference</h3><p>Für unsere erste KI nutzen wir MLX, Apples Software für maschinelles Lernen auf eigenen Chips. Die Modelle rechnen dort, wo die Daten entstehen: auf dem iPhone und im Praxisnetz. Andere Betriebssysteme werden folgen.</p></article>
  <article class="sx-card"><span class="sx-number">D</span><h3>Data Sovereignty</h3><p>Befunde sollen verschlüsselt auf dem iPhone und im Praxisnetz bleiben. Dafür ist kein Cloud-Dienst nötig.</p></article>
  <article class="sx-card"><span class="sx-number">G</span><h3>Guardrails</h3><p>Die Software prüft Ziel und Datenklasse, protokolliert die Entscheidung und lässt nur freigegebene Übertragungen zu.</p></article>
  <article class="sx-card"><span class="sx-number">E</span><h3>Exclusive Model</h3><p>Nexus baut auf Modellen mit offenen Gewichten auf. Wir passen sie auf unserem Server an medizinische Aufgaben an.</p></article>
 </div>
 <p class="sx-slide-note">SaaS steht für „Software as a Service“. Kund:innen nutzen die Software als Dienst, häufig im Abonnement.</p>
</div></section>)}

<style>
 .sx-role-figure { margin: 2.5rem auto; max-width: 1000px; }
 .sx-role-hoch { max-width: 560px; margin: 0 auto; }
 .sx-role-quer { display: none !important; }
 @media (min-width: 700px) { .sx-role-hoch { display: none !important; } .sx-role-quer { display: block !important; } }
 .sx-role-diagram { display: block; width: 100%; height: auto; font-family: var(--sx-font-body); }
 .frame { fill: var(--sx-c-bg); stroke: var(--sx-c-line); }
 .panel { fill: var(--sx-c-surface); stroke: var(--sx-c-line); }
 .accent { fill: var(--sx-c-accent); }
 .label, .kicker { fill: var(--sx-c-accent); font-weight: 700; letter-spacing: .08em; font-size: 11px; }
 .small { fill: var(--sx-c-ink-subtle); font-size: 12px; }
 .heading { fill: var(--sx-c-ink); font-size: 23px; font-weight: 750; letter-spacing: -.03em; }
 .body { fill: var(--sx-c-ink-subtle); font-size: 14px; }
 .chips rect, .flow-label-bg { fill: var(--sx-c-accent-soft); }
 .chip-text, .flow-label { fill: var(--sx-c-ink); font-size: 12px; font-weight: 650; text-anchor: middle; }
 .flow { fill: none; stroke: var(--sx-c-accent); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
</style>
