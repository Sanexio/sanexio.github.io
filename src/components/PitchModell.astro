---
const canvas = [
 ['Partner und technische Grundlagen','Eterno, Partnerpraxen und Labore. Perspektivisch auch Apotheken, Kliniken und Versicherungen. Technisch setzen wir auf Apple, Hersteller von Praxissoftware und offene Sprachmodelle.'],
 ['Was wir entwickeln','Cortex für weitere Praxen auslegen, KI-Werkzeuge steuern, Nexus trainieren, Sicherheitsregeln umsetzen und den Twin samt Praxis-Apps weiterentwickeln.'],
 ['Was wir einbringen','Cortex, die Entwicklung von Nexus, ärztliches Fachwissen und Verläufe aus einer Praxis mit rund 25.000 Patient:innen seit 1997.'],
 ['Wie wir Patient:innen begleiten','Das Praxisteam soll Befunde am Twin erklären können. Für Fragen zu Hause ist ein lokaler Chat geplant.'],
 ['Wie wir Menschen erreichen','Der erste Kontakt entsteht in der Praxis. Hinzu kommen die Websites von Praxis und Sanexio sowie Instagram, Facebook und TikTok.'],
 ['Für wen wir starten','Für gesundheitsbewusste Patient:innen mit iPhone und die Haus- und Fachärzt:innen unserer Praxisgemeinschaft.'],
 ['Wofür Kosten anfallen','Entwicklung, ärztliche Inhaltsprüfung, verschlüsselter Speicher, Trainingshardware und regulatorische Gutachten. Für lokale Anfragen fallen keine Cloud-Gebühren an.'],
 ['Womit wir Geld verdienen wollen','Sanexio plant Erlöse aus Check-ups und Longevity-Paketen der Partnerpraxen, dem Twin-Plus-Abo und kostenpflichtigen Erweiterungen für Praxen.'],
];
const kan = [['Die erste Partnerpraxis','Im Praxiszentrum am Grüneburgweg arbeiten neun Fachrichtungen auf rund 500 m². Für die eigene Praxisgemeinschaft gelten dieselben Konditionen wie für künftige Partnerpraxen.'],['Das Arztgespräch','Beim Check-up stellt die Ärztin oder der Arzt den Twin direkt am Befund vor.'],['App Store','LifeLinker ist heute über TestFlight verfügbar. Der App-Store-Start ist geplant.'],['Wartezimmer und Website','Im Wartezimmer läuft „Blood Journey“. Weitere Zugänge bieten Selbsttests auf der Website und ein QR-Code auf dem Laborbefund.'],['Ärztliche Empfehlungen','Die ersten Empfehlungen sollen aus der Praxisgemeinschaft kommen, danach aus weiteren Praxen.']];
interface Props { nur?: string[] }
const { nur } = Astro.props;
// Abschnitte einzeln platzierbar: <Baustein nur={['id']} /> zeigt nur die genannten.
const zeig = (id: string) => !nur || nur.includes(id);
---
{zeig('modell') && (<section class="sx-section sx-soft" id="modell" aria-labelledby="f12"><div class="sx-container">
 <p class="sx-eyebrow">Geschäftsmodell im Überblick</p>
 <h2 id="f12">Der Check-up bringt den Twin zu den Patient:innen</h2>
 <div class="sx-card sx-card-breit"><span class="sx-sub">Unser Angebot</span><p>Seit 1997 hat unsere Praxis rund 25.000 Patient:innen behandelt. Ihre Verläufe und unser ärztliches Wissen sollen in Nexus einfließen.</p><p>Der Twin soll Gesundheitswerte auf dem iPhone erklären. Patient:innen wählen, was sie teilen.</p><p>Cortex soll einzelne Praxis-Abos ablösen, etwa für Diktate, Termine, Erinnerungen, Befunderklärungen, Qualitätsmanagement und Dienstpläne.</p></div>
 <div class="sx-cg sx-g8">{canvas.map(([t,p]) => <article class="sx-card"><span class="sx-sub">{t}</span><p>{p}</p></article>)}</div>
 <p class="sx-slide-note">Die neun Felder folgen dem Business Model Canvas von Osterwalder und Pigneur (2010).</p>
</div></section>)}

{zeig('segmente') && (<section class="sx-section" id="segmente" aria-labelledby="f13"><div class="sx-container">
 <p class="sx-eyebrow">Kundengruppen</p>
 <h2 id="f13">Mit wem wir in Frankfurt starten</h2>
 <div class="sx-cg sx-g2">
  <article class="sx-card"><span class="sx-sub">Patient:innen ·</span><h3>Gesundheitsbewusste Menschen mit iPhone, die vorsorgen wollen</h3><ul class="sx-list"><li>Der Check-up ist der Einstieg. Später sollen Longevity, Human Performance und Human Enhancement folgen.</li><li>Zuerst laden wir Patient:innen der ersten Partnerpraxis ein.</li></ul><h3>Der Twin auf dem iPhone</h3><p>Ein Sprachmodell soll Fragen auf dem iPhone auch offline beantworten. Braucht es mehr Wissen, soll es Nexus ohne persönliche Gesundheitsdaten anfragen.</p></article>
  <article class="sx-card"><span class="sx-sub">Praxen ·</span><h3>Haus- und Fachärzt:innen mit eigener Praxis</h3><ul class="sx-list"><li>Zuerst sprechen wir Kolleg:innen der Praxisgemeinschaft an, danach weitere Haus- und Facharztpraxen.</li><li>Nach dem Pilotprojekt kommen auch Krankenkassen und Arbeitgeber infrage.</li></ul><h3>Cortex auf den eigenen Rechnern</h3><p>Cortex Local bringt Sprachmodelle und Apps auf die Praxisrechner. Medizinische Daten verarbeitet die Praxis im eigenen Haus.</p></article>
 </div>
 <p class="sx-slide-note">Das iPhone-Modell auf Basis von Qwen3 und MLX ist in Entwicklung.</p>
</div></section>)}

{zeig('kanaele') && (<section class="sx-section sx-soft" id="kanaele" aria-labelledby="f14"><div class="sx-container">
 <p class="sx-eyebrow">Markteintritt · Frankfurt am Main</p>
 <h2 id="f14">Der erste Kontakt mit dem Twin entsteht beim Check-up</h2>
 <div class="sx-cg sx-g6">{kan.map(([t,p]) => <article class="sx-card"><span class="sx-sub">{t}</span><p>{p}</p></article>)}
  <figure class="sx-media sx-media-fill"><img src="/pitch-medien/pitch-0992972d2645.webp" alt="Kampagnenmotiv zur Körperreise mit Blutabnahme am Arm und hervorgehobenen Venen" loading="lazy" width="1280" height="714" /><figcaption>Bild: Kampagne „Reise durch den Körper“</figcaption></figure>
 </div>
 <p class="sx-claim">Datenschranke, Vorsorgeregeln, Website und Kampagne sind in der ersten Praxis im Einsatz. Dort prüfen wir, welche Abläufe wir auf weitere Praxen übertragen können.</p>
 <p class="sx-slide-note">Praxiszentrum Dr. Stracke &amp; Kollegen · westend-hausarzt.com</p>
</div></section>)}
